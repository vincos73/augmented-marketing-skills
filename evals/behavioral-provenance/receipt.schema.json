{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vincos.it/schemas/ams-behavioral-receipt-v1.json",
  "title": "AMS behavioral invocation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "invocation_id", "provider", "runtime", "thread_id",
    "turn_id", "message_id", "model", "skill_id", "skill_version",
    "skill_sha256", "input_path", "input_sha256", "output_path",
    "output_sha256", "captured_at", "previous_event_sha256", "event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "invocation_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "message_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "skill_id": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "minLength": 1},
    "skill_sha256": {"$ref": "#/$defs/sha256"},
    "input_path": {"type": "string", "minLength": 1},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "output_path": {"type": "string", "minLength": 1},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "captured_at": {"type": "string", "format": "date-time"},
    "previous_event_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
