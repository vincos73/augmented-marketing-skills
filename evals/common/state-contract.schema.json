{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/augmented-marketing-suite/state-contract.schema.json",
  "title": "Augmented Marketing Suite common state contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "scenario", "shared_invariant_ids", "artifacts", "invariants", "authorization", "lineage"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "identity": {"$ref": "#/$defs/identity"},
    "scenario": {"$ref": "#/$defs/scenario"},
    "shared_invariant_ids": {"const": ["speed-60", "speed-42-conditional", "pilot-quote-01", "operations-total-sprints", "operations-weekly-starts", "sales-weekly-qualified-calls", "TRK-FAB-ERS-OWNED@1", "paid-media"]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
    "authorization": {"$ref": "#/$defs/authorization"},
    "lineage": {"$ref": "#/$defs/lineage"}
  },
  "$defs": {
    "sourceRef": {"type": "string", "pattern": "^/(?:[^/~]|~[01])+(?:/(?:[^/~]|~[01])+)*$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "state", "version", "source_ref"],
      "properties": {"id": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}}
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "profile", "version", "evidence_mode", "source_scope", "source_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "profile": {"enum": ["chat-v1", "persistent-lineage-v1", "cross-core-safety-v1", "authorization-ledger-v1", "bridge-v1", "preexecution-static-v1", "integrated-postexecution-v1"]},
        "version": {"type": "string", "minLength": 1},
        "evidence_mode": {"enum": ["synthetic_fixture", "behavioral_run", "runtime", "pilot"]},
        "source_scope": {"type": "string", "minLength": 1},
        "source_ref": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "digest": {"type": "object", "additionalProperties": false, "required": ["algorithm", "value"], "properties": {"algorithm": {"const": "sha256"}, "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "version", "digest", "state", "source_ref"],
      "properties": {
        "ref": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*@[0-9]+$"}, "version": {"type": "string", "minLength": 1},
        "digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "state": {"enum": ["conversational", "persistent", "provided", "provided_by_external_evidence", "observed", "not_created", "not_observed", "simulated"]},
        "source_ref": {"$ref": "#/$defs/sourceRef"},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "source_ref"],
      "properties": {"id": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}, "value": {}, "source_ref": {"$ref": "#/$defs/sourceRef"}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "mode", "scope", "authority", "source_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "status": {"enum": ["approved_in_chat", "approved", "authorized", "denied", "not_requested", "proposed", "not_applicable", "unknown"]},
        "mode": {"enum": ["observed", "simulated", "not_applicable", "unknown"]},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authority": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject", "decision_id", "status", "mode", "evidence_refs", "source_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "subject": {"enum": ["decision", "action", "artifact"]}, "decision_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["observed", "not_observed", "not_applicable", "unknown"]}, "mode": {"enum": ["observed", "simulated", "not_applicable", "unknown"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sourceRef"}}, "source_ref": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "authorization": {"type": "object", "additionalProperties": false, "required": ["decisions", "observations"], "properties": {"decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}}}},
    "lineage": {"type": "object", "additionalProperties": false, "required": ["edges"], "properties": {"edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "relation", "source_ref"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "relation": {"type": "string", "minLength": 1}, "source_ref": {"$ref": "#/$defs/sourceRef"}}}}}}
  }
}
