{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/augmented-marketing-suite/authorization-ledger.schema.json",
  "title": "Authorization ledger eval v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "profile", "identity", "shared_invariant_ids", "role_action_matrix", "evaluation_context", "records"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "ledger_id": {"type": "string", "minLength": 1},
    "profile": {"enum": ["chat-v1", "persistent-lineage-v1"]},
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "state"],
      "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "state": {"type": "string", "minLength": 1}}
    },
    "shared_invariant_ids": {"const": ["speed-60", "speed-42-conditional", "pilot-quote-01", "operations-total-sprints", "operations-weekly-starts", "sales-weekly-qualified-calls", "TRK-FAB-ERS-OWNED@1", "paid-media"]},
    "role_action_matrix": {
      "type": "object", "additionalProperties": false, "required": ["approve_content", "write_file", "install", "execute"],
      "properties": {
        "approve_content": {"const": ["Marketing Director"]},
        "write_file": {"const": ["Repository Maintainer"]},
        "install": {"const": ["Runtime Administrator"]},
        "execute": {"const": ["Campaign Operator"]}
      }
    },
    "evaluation_context": {
      "type": "object", "additionalProperties": false, "required": ["mode", "fixture", "generated_at"],
      "properties": {"mode": {"enum": ["simulation", "live", "review"]}, "fixture": {"type": "string", "minLength": 1}, "generated_at": {"type": "string", "format": "date-time"}}
    },
    "records": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "transition", "entity", "version", "scope", "decision", "authority", "observation", "recorded_at", "dependencies", "notes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "transition": {"enum": ["content_approval", "saving", "installation", "execution"]},
        "entity": {
          "type": "object", "additionalProperties": false, "required": ["id", "type", "path", "digest"],
          "properties": {"id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "path": {"type": ["string", "null"]}, "digest": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]}}
        },
        "version": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"enum": ["conversational", "persistent"]}, "value": {"type": "string", "minLength": 1}}},
        "scope": {"type": "object", "additionalProperties": false, "required": ["actions", "targets", "exclusions"], "properties": {"actions": {"type": "array", "minItems": 1, "maxItems": 1}, "targets": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "exclusions": {"type": "array", "items": {"type": "string"}}}},
        "decision": {"type": "object", "additionalProperties": false, "required": ["status", "mode", "basis"], "properties": {"status": {"enum": ["not_requested", "approved", "authorized", "denied", "not_applicable", "unknown"]}, "mode": {"enum": ["observed", "simulated", "not_applicable", "unknown"]}, "basis": {"type": "object", "additionalProperties": false, "required": ["kind", "source_entry_id", "summary"], "properties": {"kind": {"enum": ["explicit", "simulated", "policy", "none", "inherited"]}, "source_entry_id": {"type": ["string", "null"]}, "summary": {"type": "string"}}}}},
        "authority": {"type": "object", "additionalProperties": false, "required": ["status", "role"], "properties": {"status": {"enum": ["confirmed", "to_confirm", "not_applicable", "unknown"]}, "role": {"type": ["string", "null"]}}},
        "observation": {"type": "object", "additionalProperties": false, "required": ["subject", "status", "occurred_at", "evidence"], "properties": {"subject": {"enum": ["decision", "action"]}, "status": {"enum": ["observed", "not_observed", "not_applicable", "unknown"]}, "occurred_at": {"type": ["string", "null"]}, "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "mode", "ref", "summary"], "properties": {"kind": {"enum": ["message", "file", "receipt", "log", "policy"]}, "mode": {"enum": ["observed", "simulated"]}, "ref": {"type": "string"}, "summary": {"type": "string"}}}}}},
        "recorded_at": {"type": "string", "format": "date-time"}, "dependencies": {"type": "array", "items": {"type": "string"}}, "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
